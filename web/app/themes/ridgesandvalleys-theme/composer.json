{
  "name": "matthummel-pa/ridgesandvalleys-theme",
  "type": "wordpress-theme",
  "license": "MIT",
  "description": "Ridges & Valleys Studio theme — Blade, Tailwind CSS v4, TypeScript, Vite, Acorn.",
  "homepage": "https://ridgesandvalleys.com",
  "authors": [
    { "name": "Matt Hummel", "homepage": "https://ridgesandvalleys.com" }
  ],
  "keywords": ["wordpress", "theme", "ridges-and-valleys"],
  "support": {
    "issues": "https://github.com/matthummel-pa/ridgesandvalleys/issues"
  },
  "autoload": {
    "psr-4": { "App\\": "app/" }
  },
  "require": {
    "php": ">=8.3",
    "roots/acorn": "^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20"
  },
  "suggest": {
    "log1x/sage-directives": "Useful Blade directives for WordPress (^1.0)."
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
